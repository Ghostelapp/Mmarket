# testnet albo mainnet; to jedyny przełącznik profilu sieci
CHAIN_ENV="testnet"
SUPPORTED_NETWORKS="Base"
ENABLE_ONCHAIN_INDEXER="true"
ALLOW_INSECURE_PAYMENT_SIMULATION="false"
ONCHAIN_STATE_BLOCK_TAG="finalized"
RESERVATION_TTL_MINUTES="15"
ONCHAIN_MIN_CONFIRMATIONS="2"
ONCHAIN_MIN_CONFIRMATIONS_BASE="2"
ONCHAIN_MIN_CONFIRMATIONS_POLYGON="4"
RECONCILIATION_INTERVAL_SECONDS="60"
VERIFY_CONTRACTS_ON_STARTUP="true"
# false: API uruchomi się jako degraded przy chwilowej awarii RPC; true: przerwie start.
VERIFY_CONTRACTS_FAIL_CLOSED="false"
CONTRACT_VERIFY_TIMEOUT_SECONDS="30"
RPC_REQUEST_TIMEOUT_SECONDS="15"
PLN_TO_USDC_RATE="0.24"
FX_RATE_UPDATED_AT="2026-06-12T00:00:00Z"
FX_RATE_MAX_AGE_MINUTES="1440"

CONTRACT_ADMIN_ADDRESS=""
ARBITER_ADDRESS=""
PLATFORM_WALLET_BASE=""
PLATFORM_WALLET_POLYGON=""

RPC_URL_BASE_TESTNET="https://sepolia.base.org"
USDC_CONTRACT_BASE_TESTNET="0x036CbD53842c5426634e7929541eC2318f3dCF7e"
ESCROW_CONTRACT_BASE_TESTNET=""
PAYMENT_ROUTER_BASE_TESTNET=""
ESCROW_CODE_HASH_BASE_TESTNET=""
PAYMENT_ROUTER_CODE_HASH_BASE_TESTNET=""

RPC_URL_POLYGON_TESTNET="https://polygon-amoy.drpc.org"
USDC_CONTRACT_POLYGON_TESTNET=""
ESCROW_CONTRACT_POLYGON_TESTNET=""
PAYMENT_ROUTER_POLYGON_TESTNET=""
ESCROW_CODE_HASH_POLYGON_TESTNET=""
PAYMENT_ROUTER_CODE_HASH_POLYGON_TESTNET=""

RPC_URL_BASE_MAINNET="https://mainnet.base.org"
USDC_CONTRACT_BASE_MAINNET="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
ESCROW_CONTRACT_BASE_MAINNET=""
PAYMENT_ROUTER_BASE_MAINNET=""
ESCROW_CODE_HASH_BASE_MAINNET=""
PAYMENT_ROUTER_CODE_HASH_BASE_MAINNET=""

